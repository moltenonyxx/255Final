<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255Final.MainPage">

    <ScrollView>
        <Grid
            RowDefinitions="auto, auto"
            ColumnDefinitions="*, auto">
            <VerticalStackLayout
                Grid.Row="0"
                Grid.Column="0">

               
            </VerticalStackLayout>
            <Button
                x:Name="gameDetails"
                Text="Game Details"
                Clicked="onDetailsClicked"
                Grid.Row="0"
                Grid.Column="1"/>
            <Button
                x:Name="addGame"
                Text="Add New Game"
                Clicked="onAddGame"
                Grid.Row="1"
                Grid.Column="1"/>
        </Grid>
    </ScrollView>

</ContentPage>
